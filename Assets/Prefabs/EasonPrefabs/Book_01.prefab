  m_Name: 
  m_EditorClassIdentifier: 
  logContent: "\u65E5\u8A8C #47 - 2025/03/15\n\u4ECA\u65E5\uFF0C\u6211\u5011\u7684\u5718\u968A\u6B63\u5F0F\u555F\u52D5\u300C\u8996\u89BA\u8CE6\u4E88\u8A08\u756B\u300D\uFF08Project
    Sightgift\uFF09\u3002\u7CD6\u8C46\u4EBA\uFF08Beanfolk\uFF09\u5929\u751F\u5168\u76F2\uFF0C\u9019\u662F\u4ED6\u5011\u7A2E\u65CF\u9032\u5316\u907A\u7559\u7684\u7F3A\u9677\u3002\u6211\u5011\u7814\u767C\u7684\u85E5\u7269V-Enhance
    1.0\uFF0C\u5C07\u900F\u904E\u57FA\u56E0\u91CD\u7D44\u6FC0\u6D3B\u5176\u8996\u795E\u7D93\uFF0C\u9810\u8A08\u8B93\u4ED6\u5011\u7372\u5F97\u5B8C\u6574\u8996\u89BA\u3002\u9019\u662F\u6148\u5584\u8207\u79D1\u5B78\u7684\u5B8C\u7F8E\u7D50\u5408\u2014\u2014\u4E0D\u50C5\u89E3\u6C7A\u76F2\u75C5\uFF0C\u9084\u80FD\u63D0\u5347\u4ED6\u5011\u7684\u751F\u6D3B\u54C1\u8CEA\u3002\u521D\u6B65\u7D30\u80DE\u6E2C\u8A66\u6210\u529F\uFF0C\u7121\u660E\u986F\u526F\u4F5C\u7528\u3002\u9AD8\u5C64\u5C0D\u6B64\u6975\u5EA6\u91CD\u8996\uFF0C\u8CC7\u52A9\u5145\u88D5\u3002\u6211\u5C0D\u524D\u666F\u5145\u6EFF\u4FE1\u5FC3\u3002"
